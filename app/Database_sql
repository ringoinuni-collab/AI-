-- =========================================
-- 11. AI学習用データ取得
-- =========================================
SELECT
    h.history_id,
    h.changed_at,
    h.old_volume,
    h.new_volume,
    h.change_source,
    d.device_name,
    d.device_type,
    GROUP_CONCAT(a.app_name, ', ') AS active_applications,
    s.suggested_volume,
    s.result AS ai_result,
    c.original_volume,
    c.corrected_volume
FROM volume_history h
LEFT JOIN audio_devices d
    ON h.device_id = d.device_id
LEFT JOIN usage_context uc
    ON h.history_id = uc.history_id
LEFT JOIN applications a
    ON uc.app_id = a.app_id
LEFT JOIN ai_suggestions s
    ON h.history_id = s.history_id
LEFT JOIN user_corrections c
    ON s.suggestion_id = c.suggestion_id
GROUP BY h.history_id
ORDER BY h.changed_at DESC;

