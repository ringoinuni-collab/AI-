PRAGMA foreign_keys = ON;

-- =========================================
-- 1. ユーザー情報
-- =========================================
CREATE TABLE IF NOT EXISTS users (
    user_id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- =========================================
-- 2. ユーザー設定保存
-- =========================================
CREATE TABLE IF NOT EXISTS user_settings (
    setting_id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL UNIQUE,
    auto_adjust_enabled INTEGER NOT NULL DEFAULT 0
        CHECK (auto_adjust_enabled IN (0, 1)),
    volume_limit INTEGER NOT NULL DEFAULT 80
        CHECK (volume_limit BETWEEN 0 AND 100),
    default_volume INTEGER NOT NULL DEFAULT 50
        CHECK (default_volume BETWEEN 0 AND 100),
    FOREIGN KEY (user_id) REFERENCES users(user_id)
        ON DELETE CASCADE
);

-- =========================================
-- 3. アプリ情報保存
-- =========================================
CREATE TABLE IF NOT EXISTS applications (
    app_id INTEGER PRIMARY KEY AUTOINCREMENT,
    app_name TEXT NOT NULL,
    app_identifier TEXT NOT NULL UNIQUE
);

-- =========================================
-- 4. 使用機器情報
-- =========================================
CREATE TABLE IF NOT EXISTS audio_devices (
    device_id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    device_name TEXT NOT NULL,
    device_type TEXT NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(user_id)
        ON DELETE CASCADE
);

-- =========================================
-- 5. 音量変更履歴
-- =========================================
CREATE TABLE IF NOT EXISTS volume_history (
    history_id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    device_id INTEGER,
    changed_at DATETIME NOT NULL DEFAULT (datetime('now', 'localtime'));
    old_volume INTEGER NOT NULL
        CHECK (old_volume BETWEEN 0 AND 100),
    new_volume INTEGER NOT NULL
        CHECK (new_volume BETWEEN 0 AND 100),
    change_source TEXT NOT NULL DEFAULT 'user',
    FOREIGN KEY (user_id) REFERENCES users(user_id)
        ON DELETE CASCADE,
    FOREIGN KEY (device_id) REFERENCES audio_devices(device_id)
        ON DELETE SET NULL
);

-- =========================================
-- 6. 音量変更時の利用状況
-- =========================================
CREATE TABLE IF NOT EXISTS usage_context (
    context_id INTEGER PRIMARY KEY AUTOINCREMENT,
    history_id INTEGER NOT NULL,
    app_id INTEGER NOT NULL,
    FOREIGN KEY (history_id) REFERENCES volume_history(history_id)
        ON DELETE CASCADE,
    FOREIGN KEY (app_id) REFERENCES applications(app_id)
        ON DELETE CASCADE,
    UNIQUE (history_id, app_id)
);

-- =========================================
-- 7. AI音量提案履歴
-- =========================================
CREATE TABLE IF NOT EXISTS ai_suggestions (
    suggestion_id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    history_id INTEGER,
    suggested_volume INTEGER NOT NULL
        CHECK (suggested_volume BETWEEN 0 AND 100),
    suggested_at DATETIME NOT NULL DEFAULT (datetime('now', 'localtime'));
    result TEXT NOT NULL DEFAULT 'pending'
        CHECK (result IN (
            'pending', 'accepted', 'rejected', 'modified'
        )),
    FOREIGN KEY (user_id) REFERENCES users(user_id)
        ON DELETE CASCADE,
    FOREIGN KEY (history_id) REFERENCES volume_history(history_id)
        ON DELETE SET NULL
);

-- =========================================
-- 8. AI提案後のユーザー修正履歴
-- =========================================
CREATE TABLE IF NOT EXISTS user_corrections (
    correction_id INTEGER PRIMARY KEY AUTOINCREMENT,
    suggestion_id INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    original_volume INTEGER NOT NULL
        CHECK (original_volume BETWEEN 0 AND 100),
    corrected_volume INTEGER NOT NULL
        CHECK (corrected_volume BETWEEN 0 AND 100),
    corrected_at DATETIME NOT NULL DEFAULT (datetime('now', 'localtime'));
    FOREIGN KEY (suggestion_id) REFERENCES ai_suggestions(suggestion_id)
        ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id)
        ON DELETE CASCADE
);

-- =========================================
-- 9. AI学習用インデックス
-- =========================================
CREATE INDEX IF NOT EXISTS idx_history_user_date
ON volume_history(user_id, changed_at);

CREATE INDEX IF NOT EXISTS idx_context_history
ON usage_context(history_id);

CREATE INDEX IF NOT EXISTS idx_suggestions_user_date
ON ai_suggestions(user_id, suggested_at);

CREATE INDEX IF NOT EXISTS idx_corrections_user_date
ON user_corrections(user_id, corrected_at);

